PORT=1100
FRONTEND_URL=http://localhost:1100
CORS_ORIGIN=http://localhost:1100
CORS_CREDENTIALS=true
# Host-side `npm run dev` uses the published Redis port.
# `docker compose` overrides these so the web container uses the `redis` service.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-another-random-secret
SECRETS_KEY=replace-with-a-long-vault-key
OTP_TTL_MINUTES=5
ADMIN_EMAILS=divyanshut@espsofttech.org

MONGODB_URI=
MONGODB_USER=
MONGODB_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="ESP DevOps Portal <your-gmail@gmail.com>"

OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openrouter/free

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=
S3_BUCKET=
S3_PREFIX=esp-devops-drive

DOCKER_TERMINAL_IMAGE=esp-devops-linux:22.04
DOCKER_TERMINAL_SERVICE=linux
DOCKER_TERMINAL_CONTAINER=esp-linux-shell
